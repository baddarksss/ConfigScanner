<?xml version="1.0" encoding="utf-8"?>
<!-- Scanner radar: rings, a sweeping sector and the server nodes it detects -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- outer ring -->
    <path
        android:strokeColor="#8FB8FF"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:pathData="M54,26 A28,28 0 1,0 54,82 A28,28 0 1,0 54,26 Z" />
    <!-- top tick (radar zero mark) -->
    <path
        android:strokeColor="#BFE0FF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:pathData="M54,23.2 L54,27.6" />
    <!-- inner ring -->
    <path
        android:strokeColor="#6E93E8"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeAlpha="0.75"
        android:pathData="M54,36.5 A17.5,17.5 0 1,0 54,71.5 A17.5,17.5 0 1,0 54,36.5 Z" />
    <!-- sweep sector: wide faint layer -->
    <path
        android:fillColor="#4C8DFF"
        android:fillAlpha="0.30"
        android:pathData="M54,54 L54,26 A28,28 0 0,1 80.3,63.6 Z" />
    <!-- sweep sector: narrow bright layer -->
    <path
        android:fillColor="#7FB4FF"
        android:fillAlpha="0.45"
        android:pathData="M54,54 L54,26 A28,28 0 0,1 75.5,36 Z" />
    <!-- leading edge of the sweep -->
    <path
        android:strokeColor="#BFE0FF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M54,54 L80.3,63.6" />
    <!-- center dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,50 A4,4 0 1,0 54,58 A4,4 0 1,0 54,50 Z" />
    <!-- detected node: on the leading edge -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M80.3,60.8 A2.8,2.8 0 1,0 80.3,66.4 A2.8,2.8 0 1,0 80.3,60.8 Z" />
    <!-- detected nodes (teal / blue / white) -->
    <path
        android:fillColor="#5EEAD4"
        android:pathData="M49.1,78.6 A3,3 0 1,0 49.1,84.6 A3,3 0 1,0 49.1,78.6 Z" />
    <path
        android:fillColor="#7FB4FF"
        android:pathData="M27.7,60.6 A3,3 0 1,0 27.7,66.6 A3,3 0 1,0 27.7,60.6 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.85"
        android:pathData="M36,30.4 A2.2,2.2 0 1,0 36,34.8 A2.2,2.2 0 1,0 36,30.4 Z" />
</vector>
